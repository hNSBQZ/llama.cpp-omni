# ============================================================
# MiniCPM-o 评测套件 —— 唯一配置文件
#
# 语法是 shell 的 KEY=VALUE，`run_eval.sh` 会 source 它，所有值也会
# 原样 export 给各子流水线（Python 侧通过 os.environ 读取，优先级高于
# 子目录里的 .env / pipeline.env 默认值）。
#
# 命令行同名参数 > 环境变量 > 本文件
# ============================================================

# ------------------------------------------------------------
# 1. 模型权重
# ------------------------------------------------------------
# GGUF 根目录：里面要有 LLM 主文件，以及 vision/ audio/ tts/ token2wav-gguf/ 子目录
# 从 https://huggingface.co/openbmb/MiniCPM-o-4_5-gguf 下载后改成本地路径
MODEL_DIR=/path/to/MiniCPM-o-4_5-gguf

# 精度测试（videomme / daily-omni / tts）用的 LLM 权重
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf

# 速度测试（RTS / judge-final）用的 LLM 权重，通常跑 F16 看上限
RTS_MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf

# TTS 子模型（留空则由 C++ 侧从 MODEL_DIR/tts 自动找）
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# ------------------------------------------------------------
# 2. 服务 / 二进制路径
# ------------------------------------------------------------
# llama.cpp-omni 仓库根：RTS 从这里的 build*/bin 找 llama-omni-server。
# 本套件放在仓库内，默认取上级目录；挪到仓库外就填绝对路径。
LLAMACPP_ROOT=$(cd "${EVAL_SUITE_ROOT}/.." && pwd)

# 精度测试用的三个常驻推理 CLI 所在目录
#   llama-omni-eval-cli        (videomme)
#   llama-omni-eval-daily-cli  (daily-omni)
#   llama-omni-tts-eval        (tts)
# 三个 target 都在 tools/omni/CMakeLists.txt 里，不需要打补丁，可以一次编完：
#   cd $LLAMACPP_ROOT
#   cmake -B build -DGGML_CANN=ON -DSOC_TYPE=Ascend910 -DCMAKE_BUILD_TYPE=Release
#   cmake --build build -j \
#         --target llama-omni-eval-cli llama-omni-eval-daily-cli llama-omni-tts-eval
# 换后端就改 cmake 的开关（如 -DGGML_CUDA=ON），下面的目录名跟着改。
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build/bin

# 直接指定 RTS 的 server 二进制（留空则在 LLAMACPP_ROOT/build*/bin 里自动搜）
OMNI_SERVER_BIN=

# Ascend CANN 运行环境（run_eval.sh 会 source）
ASCEND_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh

# 采样种子。四个任务共用这一个值，取几无所谓，但必须固定：不固定的话采样器每次
# 从 std::random_device 重新播种，同一份构建重复跑分数就不一样，改动带来的真实
# 变化和采样噪声分不开。run_eval.py 会把它翻译成各流水线认的变量名
# （SAMPLER_SEED / SEED / OMNI_SAMPLER_SEED）。
#
# 这里特意写成可被环境变量覆盖的形式（本文件其余项都是无条件赋值），因为换几个
# seed 各跑一遍、看分数摆动多大，是判断「某个改动带来的提升是不是真的」的前提：
#   for s in 42 1337 20260807; do EVAL_SEED=$s ./run_all.sh --tasks videomme; done
EVAL_SEED=${EVAL_SEED:-42}

# ------------------------------------------------------------
# 3. 算力卡
# ------------------------------------------------------------
# 默认按 Ascend 配置，设备变量是 ASCEND_RT_VISIBLE_DEVICES；
# 换到 NVIDIA 机器把 DEVICE_ENV_VAR 改成 CUDA_VISIBLE_DEVICES 即可。
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES

# 可用卡编号，逗号分隔。精度测试按这个顺序给 worker 分配物理卡。
DEVICE_IDS=0,1,2,3,4,5,6,7

# 实际起几个 worker（每个 worker 独占一张卡，各自常驻一个 CLI 进程）。
# 留空 = 用满 DEVICE_IDS；填 N = 只用 DEVICE_IDS 的前 N 个。
DEVICE_COUNT=

# RTS 是单卡串行测延迟。填卡号则固定用它；留空则按空闲显存自动挑。
RTS_DEVICE_ID=

# ------------------------------------------------------------
# 4. smoke-test 样本数
#    三个精度测试样本都很多（videomme 2700 题 / daily-omni 1197 题 /
#    tts 2020 条），调试时用这几个值限制条数。0 = 跑全量。
# ------------------------------------------------------------
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2

# RTS 单次评测最多处理多少秒视频
RTS_MAX_DURATION=120

# ------------------------------------------------------------
# 5. 数据集
# ------------------------------------------------------------
# appendix/ 下是指向实际资产的软链接，改数据位置优先改这里
ASSETS_DIR=${EVAL_SUITE_ROOT}/appendix

# Video-MME
PARQUET_PATH=${ASSETS_DIR}/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/videomme/data

# Daily-Omni
DATASET_DIR=${ASSETS_DIR}/daily-omni
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl

# Seed-TTS 中文测试集
EVAL_DATA_PATH=${ASSETS_DIR}/seedtts_testset_zh/zh
EVAL_META_PATH=${EVAL_DATA_PATH}/meta.lst

# RTS 输入视频（多个用空格分隔）
RTS_VIDEO=${EVAL_SUITE_ROOT}/judge-final/assets/video/omni_duplex1.mp4

# ------------------------------------------------------------
# 6. TTS 打分侧模型
# ------------------------------------------------------------
# WER：FunASR paraformer-zh
PARAFORMER_MODEL=${ASSETS_DIR}/paraformer-zh
# SIM：WavLM-large + ECAPA 微调 ckpt（文件不存在则自动跳过 SIM）
SPEAKER_CKPT=${ASSETS_DIR}/wavlm_large_finetune.pth
# WavLM backbone 来源（torch.hub 从本地 clone 加载）
S3PRL_REPO=${ASSETS_DIR}/s3prl
# WavLM-large 预训练权重。s3prl 只认 huggingface URL、下载目录硬编码在
# $HOME/.cache/s3prl/download，run_eval.py 会先把这个文件按 URL 的 sha256
# 命名软链进那个缓存目录。离线机器上不摆好的话，SIM 每一对都要先等一次网络
# 超时再把异常吞掉，一个分数都落不下来。
WAVLM_LARGE_PT=${ASSETS_DIR}/wavlm_large.pt
# prompt_bundle 提取用的 Step-Audio-2-mini ONNX
ONNX_MODEL_DIR=${ASSETS_DIR}/Step-Audio-2-mini/token2wav

# ------------------------------------------------------------
# 7. Python 解释器
# ------------------------------------------------------------
# 精度测试要 pandas/torch/funasr/librosa 等重依赖，一般单独开一个 venv，
# 这里填那个 venv 的 python，例如 /path/to/venv-eval/bin/python
EVAL_PYTHON=python3
# RTS 只要 requests/websockets/numpy/soundfile
RTS_PYTHON=python3

# ------------------------------------------------------------
# 8. 推理参数
# ------------------------------------------------------------
CTX_SIZE=40960

# F16 matmul 权重走 CANN NZ 转换会导致 logits 退化，表现为空串、纯换行复读
# 或无关 token；量化权重不走这条路径。四个任务统一关闭。
GGML_CANN_WEIGHT_NZ=off

# ggml-cann 的 ACL graph capture，本仓库默认 on（ggml/src/ggml-cann/common.h）。
# capture 期间不允许同步 aclrtMemcpy，而 vision_image_batch_encode 要逐帧把数据
# 拷到 device，开着会 abort：
#   CANN error EE9999: rtMemcpy execution failed,
#   reason=the current capture mode does not support this operation (107030)
# 四个任务都走 vision encode，所以统一关掉。副作用是 LLM decode 少了图复用，
# 但实测精度测试反而快很多（单题 5min → 14s，capture 每轮都 miss 重建）。
GGML_CANN_ACL_GRAPH=off

# TTS 侧设备：C++ LLM offload 层数 / Token2Wav 设备 / prompt_bundle 提取设备
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
# TTS 打分（ASR 与说话人相似度）跑在 CPU，NPU 上没有 torch 后端
WER_DEVICE=cpu
SIM_DEVICE=cpu
