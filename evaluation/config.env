# MiniCPM-o 评测套件配置（shell KEY=VALUE）
# 优先级：命令行 > 环境变量 > 本文件。详见 evaluation/README.md
#
# 这份文件用于在自己的机器上跑通全流程。正式评测由平台注入另一份配置，RTS（速度
# 任务）的输入集合、卡数和轮换次数都与本文件不同，口径见第 6 节与 README。

# --- 1. 模型权重 ---
# GGUF 根目录（含 LLM 与 vision/ audio/ tts/ token2wav-gguf/）
# https://huggingface.co/openbmb/MiniCPM-o-4_5-gguf
MODEL_DIR=/path/to/MiniCPM-o-4_5-gguf

# 精度任务 LLM
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
# 速度任务 LLM
RTS_MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
# TTS 子模型（可留空，由 C++ 从 MODEL_DIR/tts 查找）
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf

# --- 2. 路径 ---
# 仓库根（默认上级目录）
LLAMACPP_ROOT=$(cd "${EVAL_SUITE_ROOT}/.." && pwd)
# 精度 CLI 所在目录（llama-omni-eval-cli / daily-cli / tts-eval）
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build/bin
# RTS server 二进制（留空则自动搜索）
OMNI_SERVER_BIN=
ASCEND_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
# 四任务共用采样种子（可环境变量覆盖）
EVAL_SEED=${EVAL_SEED:-42}

# --- 3. 算力卡 ---
# Ascend: ASCEND_RT_VISIBLE_DEVICES；NVIDIA: CUDA_VISIBLE_DEVICES
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0,1,2,3,4,5,6,7
# worker 数；留空=用满 DEVICE_IDS
DEVICE_COUNT=

# --- 4. smoke 条数（0=全量）---
SMOKE_VIDEOMME=2
SMOKE_DAILY_OMNI=2
SMOKE_TTS=2

# --- 5. 数据集 ---
ASSETS_DIR=${EVAL_SUITE_ROOT}/appendix

PARQUET_PATH=${ASSETS_DIR}/videomme/test-00000-of-00001.parquet
VIDEO_DATA_DIR=${ASSETS_DIR}/videomme/data

DATASET_DIR=${ASSETS_DIR}/daily-omni
ANNOTATION_PATH=${DATASET_DIR}/daily_omni.jsonl

EVAL_DATA_PATH=${ASSETS_DIR}/seedtts_testset_zh/zh
EVAL_META_PATH=${EVAL_DATA_PATH}/meta.lst

# --- 6. RTS（速度任务）---
#
# 下面这些变量不是可有可无的开关，每一个都在保证"测出来的 RTF 是模型算力，而不是
# 数据准备、并发调度或异步竞态的产物"。删掉或改掉某一项，自测仍然会打印一个数字，
# 但那个数字和正式评测已经不是同一个东西，据此做的优化判断也不成立。
#
# 正式评测与本文件的差别只有三处：测试集合（未公开）、卡数、轮换次数。其余全部
# 相同，所以自测能验证的是链路和有效性，而不是最终成绩。
#
# 另外，RTF 的分子来自 C++ 侧上报的各阶段耗时。优化实现可以改，计时口径本身不能改，
# 正式评测会核对上报值并人工复核 diff，详见 README「RTF 口径」。
#
# 输入：预切分的 1 秒 WAV/JPG，不在评测时解码 MP4 —— 解码耗时和取帧抖动会混进
# 速度成绩。先生成一次自测输入（写进 .gitignore，不入库）：
#
#     python3 judge-final/scripts/make_test_case.py
#
# 也可以对自己的视频跑同一个脚本，切分参数与正式评测一致。
RTS_TEST_CASE_DIR=${EVAL_SUITE_ROOT}/judge-final/assets/test_case
# 下面两项仅在 RTS_TEST_CASE_DIR 留空时生效，走实时解码 MP4 的旧路径，正式评测不用
RTS_VIDEO=${EVAL_SUITE_ROOT}/judge-final/assets/video/omni_duplex1.mp4
RTS_VIDEO_DIR=
# 最多评测前 N 个；0=全部
RTS_VIDEO_COUNT=0

# RTS worker 卡号（逗号分隔）；留空=回退 RTS_DEVICE_ID，再回退 DEVICE_IDS。
# worker 数取 min(卡数, 输入数)，所以单卡也能跑通，只是串行。
RTS_DEVICE_IDS=
RTS_DEVICE_COUNT=
# 兼容用的单卡项；RTS_DEVICE_IDS 为空时用它
RTS_DEVICE_ID=
# 各 worker 依次使用 RTS_BASE_PORT + worker_id
RTS_BASE_PORT=19060

# 分配方式。round_robin=单轮交错；rotating_groups=分组后跨卡轮换，让每个输入在每
# 张卡上各跑一次，抵消卡间差异。轮数不能超过 worker 数，所以单卡自测只能用
# round_robin + 1 轮。正式评测用 rotating_groups 做完整轮换。
RTS_ASSIGNMENT_MODE=round_robin
RTS_ROTATION_ROUNDS=1

# 客户端提交相邻 frame 的间隔。这是"实时"的定义：一秒的输入必须按一秒的节奏喂进
# 去。改大等于放慢输入、让模型有富余时间，测出来的就不是实时场景了。
RTS_SEND_INTERVAL_S=1
# 单个输入最多评测多少秒
RTS_MAX_DURATION=120
# 输入前后补的静音秒数。预切分输入两端都不补，补了会多出无对应输入的帧。
RTS_PAD_BEFORE=0
RTS_PAD_AFTER=0

# 每次启动/重启 server、重新加载模型前等待秒数。相邻输入之间会整体重启 server 而
# 不是只清 KV，保证每个输入都从干净状态开始。
RTS_MODEL_LOAD_SLEEP_S=2
# server 启动健康检查超时
RTS_READY_TIMEOUT_S=300

# 计分所需的有效 core 帧下限。core 是掐掉首帧（冷启动）和尾帧（含 flush）之后的稳
# 态帧，单帧抖动大，样本太少的 RTF 不能用来比较。这里的 3 只够自测跑通单个输入；
# 正式评测的门槛远高于此，靠多输入池化达到。
RTS_MIN_CORE_FRAMES=3
# 数据或基础设施失败后的重试次数。0=不重试：性能不达标不允许靠重跑挑更快的结果。
RTS_MAX_RETRIES=0

# --- 7. TTS 打分模型 ---
PARAFORMER_MODEL=${ASSETS_DIR}/paraformer-zh
SPEAKER_CKPT=${ASSETS_DIR}/wavlm_large_finetune.pth
S3PRL_REPO=${ASSETS_DIR}/s3prl
# 离线环境必须预先放好，否则 SIM 可能长时间无结果
WAVLM_LARGE_PT=${ASSETS_DIR}/wavlm_large.pt
ONNX_MODEL_DIR=${ASSETS_DIR}/Step-Audio-2-mini/token2wav

# --- 8. Python ---
# 建议填 venv 绝对路径，例如 /path/to/.venv-eval/bin/python
EVAL_PYTHON=python3
RTS_PYTHON=python3

# --- 9. 推理参数 ---
CTX_SIZE=40960
# Ascend 上请保持 off（F16 精度 / vision encode 稳定性）
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off

CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
WER_DEVICE=cpu
SIM_DEVICE=cpu
